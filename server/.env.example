# Copy this file to .env and adjust values as needed

# Server
PORT=5000

# Local MongoDB (Compass) — sabha-management database
MONGO_URI=mongodb://localhost:27017/sabha-management

# JWT
JWT_SECRET=change_this_secret

# Superadmin login (Sabha)
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=admin123

# Seva admin login
SUPERADMIN2_USERNAME=seva_admin
SUPERADMIN2_PASSWORD=seva123
